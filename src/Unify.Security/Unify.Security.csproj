<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(UnifyTargetFrameworks)</TargetFrameworks>
    <Platforms>$(UnifyTargetPlatforms)</Platforms>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace>CNCO.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="IKVM" Version="8.15.0" />
    <PackageReference Include="Xamarin.AndroidX.Security.SecurityCrypto">
      <Version>1.1.0.1</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Platforms\Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unify\Unify.csproj" />
  </ItemGroup>
</Project>
