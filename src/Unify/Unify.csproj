<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(UnifyTargetFrameworks)</TargetFrameworks>
    <Platforms>$(UnifyTargetPlatforms)</Platforms>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace>CNCO.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <Title>Unify Library</Title>
    <Description>Collection of tools and code snippets used throughout various CNCO projects.</Description>
    <Copyright>CNCO</Copyright>
    <RepositoryUrl>https://github.com/C0Newb/CNCO.Unify</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
