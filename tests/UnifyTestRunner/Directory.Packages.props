<Project>
  <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Needed so the Xamarin.AndroidX.Core.Core.Ktx pin below actually applies: it's never
      directly referenced by any project here, only pulled in transitively (via
      Avalonia.Android / Xamarin.AndroidX.Core.SplashScreen -> AppCompatResources). Without
      this flag, CPM only pins packages that are directly referenced, and Core.Ktx would keep
      floating to whatever NuGet resolves on its own.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia packages -->
    <!-- Important: keep version in sync! -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.iOS" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Android" Version="12.1.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.3.3" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="DialogHost.Avalonia" Version="0.12.3" />
    <PackageVersion Include="NUnit.Engine" Version="3.22.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == '$(UnifyAndroidTargetFramework)'">
    <PackageVersion Include="IKVM" Version="8.16.0" />
    <PackageVersion Include="Xamarin.AndroidX.Security.SecurityCrypto">
      <Version>1.1.0.3</Version>
    </PackageVersion>
    <!--
      Xamarin.AndroidX.AppCompat.AppCompatResources (pulled in transitively via
      Xamarin.AndroidX.Core.SplashScreen) forces Xamarin.AndroidX.Core up to 1.19.0.1, while
      Xamarin.AndroidX.Core.Core.Ktx otherwise resolves to an older, mismatched 1.17.0.2.
      A mismatched core/core-ktx pair ships duplicate Kotlin-extension classes and R8/D8
      fails with "Type ... is defined multiple times" at dex-merge time - pin both to the
      same matching version.
    -->
    <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.19.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
  </ItemGroup>
</Project>